# SQLite (path relatif terhadap folder prisma/). Untuk PostgreSQL ganti provider di schema.prisma.
DATABASE_URL="file:./dev.db"

# Wajib diganti di produksi: string acak minimal 32 karakter (mis. `openssl rand -base64 32`).
SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# Set "true" hanya bila aplikasi diakses lewat HTTPS.
COOKIE_SECURE="false"

# Zona waktu untuk menentukan "hari ini".
APP_TIMEZONE="Asia/Jakarta"

# Folder penyimpanan foto bukti (di luar public/, diakses lewat route terautentikasi).
UPLOAD_DIR="./uploads"
